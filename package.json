{
  "name": "gain-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "format": "prettier --write .",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "mpg123-decoder": "^1.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "25.0.10",
    "astro": "^7.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.3"
  }
}
