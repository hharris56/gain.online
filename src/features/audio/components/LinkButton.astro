---
interface Props {
  link: string;
  icon: "spotify" | "apple" | "soundcloud";
  text?: string;
}
const { link, icon, text } = Astro.props;

const ICONS: Record<string, string> = {
  spotify: "/icons/spotify%20icon.png",
  apple: "/icons/apple%20music%20icon.png",
  soundcloud: "/icons/soundcloud%20icon.png",
};
---
<a class="link-button" href={link} target="_blank" rel="noopener">
  <img src={ICONS[icon]} alt="" class="link-icon" />
  {text && <p>{text}</p>}
</a>

<style>
  .link-button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--secondary-text-color);
    border-radius: 0.25rem;
    text-decoration: none;
    color: inherit;
  }
  .link-icon {
    width: 1.5rem;
    height: 1.5rem;
  }
  .link-button p {
    margin: 0 0.5rem;
    width: 100%;
    text-align: center;
  }
</style>
