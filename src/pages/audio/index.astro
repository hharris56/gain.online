---
/**
 * The audio catalogue. The old page put these two groups behind a tab selector;
 * both render as labelled sections now, so nothing needs JS to be reachable.
 */
import Main from "@/layouts/Main.astro";
import { catalogue, artUrl } from "@/data/albums";
---

<Main title="gain audio">
  <div class="page-content-container">
    <div class="mb-4">
      <h1 class="text-4xl font-bold my-4">gain audio</h1>
      <div class="flex flex-col">
        <span>lofi / ambient house + jungle + breakcore.</span>
        <span>sound seeker.</span>
      </div>
    </div>

    {catalogue.map((group) => (
      <section class="mt-8">
        <h2 class="text-center text-xl lowercase">{group.heading}</h2>
        <div class="albums">
          {group.items.map((a) => (
            <div class="album-item">
              {a.slug ? (
                <a href={`/audio/${a.slug}`}>
                  <img
                    src={artUrl(a.cover)}
                    alt={`${a.title} cover art`}
                    loading="lazy"
                  />
                </a>
              ) : (
                <img
                  src={artUrl(a.cover)}
                  alt={`${a.title} cover art`}
                  loading="lazy"
                />
              )}
              <div class="album-info">
                <i>{a.title}</i>
                <span class="album-year">{a.year}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Main>

<style>
  .albums {
    margin: 1rem 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
  }
  .album-item {
    width: 80%;
    margin: 1rem 1rem 2rem;
  }
  .album-item img {
    width: 100%;
  }
  .album-info {
    display: flex;
    flex-direction: column;
    text-align: center;
    margin-top: 0.5rem;
  }
  .album-info i {
    font-size: 1.5em;
    font-weight: bold;
  }
  .album-year {
    font-size: 0.75em;
  }

  @media (min-width: 40rem) {
    .albums {
      display: flex;
      flex-direction: row;
    }
    .album-item {
      min-width: 10rem;
      max-width: 20%;
      max-height: fit-content;
    }
  }
</style>
