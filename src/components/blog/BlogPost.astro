---
import LineDecoration from "@/components/LineDecoration.astro";
import Tag from "./Tag.astro";

interface Props {
  title: string;
  date: string;
  tags?: string[];
}
const { title, date, tags } = Astro.props;
---

<div class="flex flex-row mb-8">
  <LineDecoration />
  <div class="flex flex-col">
    <div class="w-full flex flex-row justify-between items-center">
      <h3 class="underline">{title}</h3>
      <div class="h-6 flex gap-2">
        {tags?.map((t) => <Tag name={t} />)}
      </div>
    </div>
    <p class="text-xs text-(--secondary-text-color)">{date}</p>
    <div class="mt-4"><slot /></div>
    <div class="min-w-full min-h-4"></div>
  </div>
</div>
