---
/** SoundCloud embed. Static — no state, so no custom element needed. */
interface Props { trackId: number }
const { trackId } = Astro.props;

const src =
  `https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/${trackId}` +
  "&color=ADD8E6&show_playcount=false&sharing=false";
---
<iframe
  width="100%"
  height="166"
  allow="autoplay"
  class="media-player"
  src={src}
  loading="lazy"
  title="SoundCloud player"></iframe>
