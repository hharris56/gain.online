---
/**
 * The site's icon rail — a gradient bar (mobile) / column (desktop) of shuffled
 * feather icons, with a [+] button to reshuffle.
 *
 * The SVGs are inlined at build time (see feather-icons.ts), so this ships no
 * icon library. The shuffle itself is the only behavior, handled by the
 * <gain-icon-shuffle> custom element below.
 */
import { ICONS, PLUS_ICON } from "./feather-icons";
---

<div
  class="z-10 sticky top-0 max-w-screen flex items-center justify-start overflow-hidden gradient-x min-h-16 p-2 gap-2 md:h-[calc(100vh-4rem)] md:min-w-24 md:gradient-y md:p-4 md:gap-4 md:flex-col md:justify-start md:top-8"
>
  <gain-icon-shuffle class="contents">
    <button
      type="button"
      data-shuffle
      aria-label="Shuffle icons"
      class="shrink-0 cursor-pointer bg-transparent border-0 p-0 leading-none"
      set:html={PLUS_ICON}
    />
    <div
      data-icons
      class="flex flex-row md:flex-col gap-1 overflow-hidden shrink-0"
    >
      {
        ICONS.map((svg) => (
          <div class="gain-icon opacity-0" set:html={svg} />
        ))
      }
    </div>
  </gain-icon-shuffle>
</div>

<style>
  /* Each icon pops in, staggered. The delay is set per-element by the custom
     element after shuffling, via the --i custom property. */
  .gain-icon {
    animation: pop-in 0.5s ease-out forwards;
    animation-delay: calc(var(--i, 0) * 0.1s);
  }
</style>

<script>
  /**
   * Shuffles the icon rail. The icons are already in the DOM as static HTML, so
   * this only reorders existing nodes and restarts their pop-in animation —
   * nothing is created or fetched.
   */
  class GainIconShuffle extends HTMLElement {
    connectedCallback() {
      this.querySelector("[data-shuffle]")?.addEventListener("click", () =>
        this.shuffle(),
      );
      this.shuffle();
    }

    shuffle() {
      const box = this.querySelector<HTMLElement>("[data-icons]");
      if (!box) return;

      const icons = Array.from(box.children) as HTMLElement[];

      // Source - https://stackoverflow.com/a/2450976
      // Posted by ChristopheD, modified by community. See post 'Timeline' for
      // change history. Retrieved 2026-08-09, License - CC BY-SA 4.0
      for (let i = icons.length; i !== 0; ) {
        const r = Math.floor(Math.random() * i);
        i--;
        [icons[i], icons[r]] = [icons[r], icons[i]];
      }

      // Re-append in the new order, restarting the stagger as we go.
      icons.forEach((icon, index) => {
        icon.style.animation = "none";
        box.appendChild(icon);
        icon.style.setProperty("--i", String(index));
        void icon.offsetWidth; // force reflow so the animation re-runs
        icon.style.animation = "";
      });
    }
  }

  if (!customElements.get("gain-icon-shuffle")) {
    customElements.define("gain-icon-shuffle", GainIconShuffle);
  }
</script>
