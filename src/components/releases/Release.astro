---
import LineDecoration from "@/components/LineDecoration.astro";
import { coverUrl, type Release } from "@/data/releases";

type Props = Release;
const { title, artist, link, cover, description } = Astro.props;
---

<div class="w-full flex flex-row">
  <LineDecoration />
  <div class="flex flex-col">
    <h2 class="mb-4 text-xl"><b>{artist}</b> | {title}</h2>

    <div class="flex flex-col xs:flex-row box-border">
      <img
        class="w-full xs:w-1/3 aspect-square mb-2 xs:mb-0"
        src={coverUrl(cover)}
        alt={`${title} cover art`}
        loading="lazy"
      />
      <div class="w-full h-full flex flex-col justify-center items-center">
        <div class="xs:px-8 text-center">{description}</div>
        {/* The old version rendered href="" here, so this went nowhere. */}
        {link && <a href={link} target="_blank" rel="noopener">[listen now]</a>}
      </div>
    </div>
  </div>
</div>
